# Copy to .env and fill in. Never commit real values.
PORT=5000
NODE_ENV=development

# Database and cache
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me
AES_KEY=<32-byte key for encrypting 2FA secrets>
GOOGLE_CLIENT_ID=

# Payments (use Razorpay test keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI search
GEMINI_API_KEY=

# Product images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=ap-south-1
S3_PUBLIC_BASE_URL=

# Email
RESEND_API_KEY=
FROM_EMAIL=noreply@example.com

# Site
APP_URL=https://vkart.balavardhan.dev
# APP_ORIGIN=http://localhost:3000

# Catalog and demo switches
CATALOG_ACTIVE_ONLY=false
DEMO_LOGINS=true
